{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/|data/|cesium/|assets/).*)", "destination": "/index.html" }],
  "functions": { "api/parse.ts": { "maxDuration": 10 } }
}
